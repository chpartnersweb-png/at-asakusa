---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import Icon from './Icon.astro';
import { navigation, links } from '../data/property';
---
<a class="skip-link" href="#main">本文へ移動</a>
<header class="site-header" data-header>
  <div class="header-start">
    <div class="menu-toggle-slot" data-menu-toggle-slot>
      <button type="button" class="menu-toggle" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="menu-toggle-icon" aria-hidden="true"><span class="menu-toggle-line menu-toggle-line-first"></span><span class="menu-toggle-line menu-toggle-line-second"></span></span>
        <span class="menu-toggle-label" aria-hidden="true"><span data-menu-label-open>MENU</span><span data-menu-label-close>CLOSE</span></span>
      </button>
    </div>
    <nav class="desktop-nav" aria-label="メインナビゲーション">
      <a href="#about">AT ASAKUSAについて</a>
      <a href="#rooms">お部屋を見る<Icon name="diagonal" /></a>
    </nav>
  </div>
  <a href="#top" class="brand" aria-label="AT ASAKUSA ホーム">
    <Image src={logo} alt="AT ASAKUSA" width={180} format="webp" loading="eager" />
  </a>
  <div class="header-actions">
    <a href="#access" class="header-utility"><Icon name="pin" /><span>アクセス</span></a>
    <a href={links.line} class="header-utility header-line" target="_blank" rel="noopener noreferrer"><Icon name="message" /><span>LINE</span></a>
    <a href="#reservation" class="header-book" aria-label="お部屋を選んで予約"><Icon name="calendar" /><span>BOOK</span></a>
  </div>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label="サイトメニュー" data-menu data-lenis-prevent>
  <div class="mobile-menu-panel" data-menu-panel>
  <div class="mobile-menu-inner">
    <p class="eyebrow">YOUR HOME IN ASAKUSA</p>
    <nav aria-label="サイトメニューナビゲーション">
      {navigation.map((item, i) => <a href={item.href}><small>0{i + 1}</small><span><b>{item.en}</b><em>{item.ja}</em></span><Icon name="diagonal" /></a>)}
    </nav>
    <a class="button button-dark" href="#reservation">お部屋を選んで予約<Icon name="diagonal" /></a>
    <a href={links.line} class="mobile-contact" target="_blank" rel="noopener noreferrer">LINEでお問い合わせ<Icon name="diagonal" /></a>
  </div>
  </div>
</dialog>
<a href="#reservation" class="mobile-book"><span>RESERVATION</span><b>お部屋を選んで予約</b><Icon name="diagonal" /></a>
